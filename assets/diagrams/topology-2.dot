graph G { graph [bgcolor="transparent",pad="0.35",nodesep="0.6",ranksep="0.9",fontname="DejaVu Sans",label="Topologia 2 — laboratorio SDN",labelloc=t,fontsize=18]; node [fontname="DejaVu Sans",shape=box,style="rounded,filled",color="#94a3b8",fillcolor="#f1f5f9",margin="0.22,0.12"]; edge [color="#64748b",fontname="DejaVu Sans",fontsize=10]; c0 [label="Ryu controller (c0)\nOpenFlow 1.3",fillcolor="#dbeafe"]; h1 [label="h1 • 10.0.0.1\nUDP (attaccante simulato)",fillcolor="#fee2e2"];h2 [label="h2 • 10.0.0.2\nTCP legittimo",fillcolor="#dcfce7"];h3 [label="h3 • 10.0.0.3\nserver",fillcolor="#e0e7ff"];h4 [label="h4 • 10.0.0.4\nlegittimo",fillcolor="#dcfce7"]; s1;s2;s3;s4; h1 -- s1 [label="6 Mbps"]; h2 -- s2 [label="6 Mbps"];h3 -- s4 [label="6 Mbps"];h4 -- s1 [label="6 Mbps"]; s1 -- s3 [label="10 Mbps"];s2 -- s3 [label="10 Mbps"];s3 -- s4 [label="10 Mbps"]; c0 -- s1 [style=dashed,color="#0284c7"];c0 -- s2 [style=dashed,color="#0284c7"];c0 -- s3 [style=dashed,color="#0284c7"];c0 -- s4 [style=dashed,color="#0284c7"]; }